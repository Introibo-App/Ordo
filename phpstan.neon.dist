includes:
    - vendor/phpstan/phpstan-phpunit/extension.neon
    - vendor/szepeviktor/phpstan-wordpress/extension.neon
parameters:
    level: 6
    paths:
        - ordo.php
        - uninstall.php
        - bin
        - src
        - tests
    excludePaths:
        - src/Core/*
        # The WordPress function stubs redeclare core functions (guarded) purely so
        # the tests run without WordPress; phpstan-wordpress already provides the real
        # signatures, so analysing the stubs would only double-declare them.
        - tests/wp-stubs.php
    scanDirectories:
        - src/Core/src
    bootstrapFiles:
        - phpstan-bootstrap.php
