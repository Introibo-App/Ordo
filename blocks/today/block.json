{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "ordo/today",
	"version": "0.1.0",
	"title": "Ordo — Today",
	"category": "widgets",
	"icon": "calendar-alt",
